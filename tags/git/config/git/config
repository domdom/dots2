[alias]
    root = rev-parse --show-toplevel
    s = status --short
    st = status

    amend = commit --amend
    dmend = "!f() { git reset --soft HEAD^ && git reset -p $@ && git commit -C ORIG_HEAD; }; f"

    wip = commit -m wip
    d = diff
    ds = diff --staged
    fush = push --force-with-lease --set-upstream origin

    f = fetch origin --prune

    # Logging
    l    = !git log --graph --source --decorate-refs-exclude=refs/remotes/backup --format=tformat:'%C(bold blue)%h%C(yellow):%Creset%s %C(green)%an%Creset%C(dim normal) (%cr)%C(auto)%n%-d%Creset' --date-order
    la   = !git l --all
    ld   = !git l --branches=dom
    lr   = !git l HEAD master origin/master --branches=release-\\* --branches=origin/release-\\*

    lsummary = !git log --source --decorate-refs-exclude=refs/remotes/backup --format=tformat:'%s' --date-order

    out = "log --graph HEAD --remotes=origin/(master|release-*) --format=tformat:'%C(cyan)%h%Creset%C(dim white):%Creset%<(90,trunc)%s %C(dim white)%<(17,trunc)%an%Creset %C(green)%cd%C(auto)%n%-D%Creset'"
    r = "rebase --interactive --autostash --autosquash --update-refs"
    ref = "add -u"
    v = "log --graph --source --stat --format=format:'%w(0,0,1)%C(cyan)%H%Creset%C(auto)%d%Creset%n%n%C(yellow)%cD%Creset %C(green)(%cr)%Creset%n%C(yellow)%an %C(dim normal)<%ae>%n%n%Creset%s%n%n%-b%n'"
    va = "!git v --all"

    move-impl = !git rebase --autostash --onto $1 $2 $3 && git target $1 && :
    move = !git move-impl $1 $(git merge-base "origin/"$(git target) HEAD) $(git branch --show-current)

