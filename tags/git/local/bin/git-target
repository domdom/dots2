#!/usr/bin/env bash

current_branch=$(git branch --show-current)

current_target=$(git config --local "branch.$current_branch.target")

if [[ -n "$current_target" ]]; then
    printf "%s\n" "$current_target"
    exit 0
fi


# Release branches target themselves
if [[ $current_branch =~ ^release-([[:digit:]]+)$ ]]; then
    printf "%s\n" "$current_branch"
    exit 0
fi

# Master also targets itself
if [[ $current_branch = "master" ]]; then
    printf "%s\n" "$current_branch"
    exit 0
fi



